OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MINIMAX_API_KEY=
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MINIMAX_MODEL=MiniMax-M3
STORAGE_DIR=./data
DEFAULT_TARGET_LANG=zh-CN
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_TARGET_LANGS=zh-CN,zh-TW,ja-JP,ko-KR,en-US
MAX_UPLOAD_BYTES=52428800
TRANSLATION_CONCURRENCY=2
TRANSLATOR_MAX_ATTEMPTS=2
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_ENABLE_VISION_ANALYSIS=false
LAYOUT_PLANNER_MODEL=gpt-4.1-mini
VISION_ANALYZER_MODEL=gpt-4.1-mini
OCR_PROVIDER_ORDER=pix2text,deterministic
OCR_MIN_CONFIDENCE=0.35
OCR_PROVIDER_TIMEOUT_SECONDS=12
OCR_MAX_VISUAL_CANDIDATES=4
FORMULA_RECOGNITION_CONCURRENCY=8
FORMULA_VISUAL_OCR_CONCURRENCY=2
RENDER_FONT_STACK=Noto Sans CJK SC,Source Han Sans SC,Arial Unicode MS,sans-serif
RENDER_LINE_HEIGHT=1.35
RENDER_PARAGRAPH_SPACING_EM=0.45
RENDER_MIN_FONT_SCALE=0.86
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
