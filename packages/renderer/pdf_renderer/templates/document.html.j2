<!doctype html>
<html lang="{{ document.target_lang }}">
  <head>
    <meta charset="utf-8" />
    <style>
      * {
        box-sizing: border-box;
      }

      {% for page in document.pages %}
      @page page-{{ page.page_id | css_class }} {
        size: {{ page.size.width }}pt {{ page.size.height }}pt;
        margin: 0;
      }
      {% endfor %}

      html,
      body {
        margin: 0;
        background: #ececec;
        color: #101010;
        font-family: {{ document.font_stack | css_font_stack }};
        letter-spacing: 0;
      }

      .page {
        position: relative;
        width: var(--page-width-pt);
        height: var(--page-height-pt);
        margin: 0 auto 18px auto;
        background: #ffffff;
        overflow: hidden;
        page-break-after: always;
        break-after: page;
      }

      .block {
        position: absolute;
        left: var(--x-pt);
        top: var(--y-pt);
        width: var(--w-pt);
        height: var(--h-pt);
        overflow: hidden;
        padding: 0;
        font-size: var(--font-size-pt);
        line-height: var(--line-height, {{ document.line_height }});
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        color: #111111;
        font-weight: var(--font-weight, 400);
        font-style: var(--font-style, normal);
        text-align: var(--text-align, left);
        text-indent: var(--first-line-indent-em, 0em);
      }

      .asset {
        position: absolute;
        left: var(--x-pt);
        top: var(--y-pt);
        width: var(--w-pt);
        height: var(--h-pt);
        overflow: hidden;
        background: #f5f5f5;
        border: 0.5pt solid rgb(80 80 80 / 18%);
      }

      .asset img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .asset-placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        color: #666666;
        font-size: 8pt;
        text-align: center;
      }

      .block[data-bold="true"] {
        font-weight: 700;
      }

      .block[data-italic="true"] {
        font-style: italic;
      }

      .role-abstract,
      .role-paragraph {
        text-align: var(--text-align, justify);
      }

      .role-reference {
        overflow-wrap: break-word;
      }

      .role-table {
        white-space: pre-wrap;
      }

      .role-formula {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .katex,
      .katex-display {
        font-family: "KaTeX_Main", "Cambria Math", "STIX Two Math", "Times New Roman", serif;
        font-size: 1em;
        line-height: 1.2;
        white-space: normal;
      }

      .katex-display {
        display: block;
        width: 100%;
        text-align: center;
      }

      .katex-mathml {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(1px, 1px, 1px, 1px);
      }

      .katex-html {
        white-space: pre-wrap;
      }

      .formula-image-fallback {
        display: inline-block;
        max-width: 100%;
        vertical-align: middle;
      }

      .formula-image-fallback img {
        display: inline-block;
        max-width: 100%;
        max-height: 1.8em;
        object-fit: contain;
        vertical-align: middle;
      }

      .katex-frac {
        display: inline-grid;
        grid-template-rows: auto auto;
        align-items: center;
        justify-items: center;
        vertical-align: middle;
        margin: 0 0.12em;
      }

      .katex-num {
        border-bottom: 0.08em solid currentColor;
        padding: 0 0.16em 0.08em;
      }

      .katex-den {
        padding: 0.08em 0.16em 0;
      }

      .katex-sqrt {
        display: inline-flex;
        gap: 0.04em;
        align-items: baseline;
      }

      .role-footnote {
        color: #222222;
      }

      .page-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 18pt;
        text-align: center;
        font-size: 10.5pt;
        line-height: 1;
        font-family: {{ document.font_stack | css_font_stack }};
        color: #111111;
      }

      .intent-compact {
        font-size: var(--font-size-pt);
      }

      .quality-missing-translation,
      .quality-empty-translation,
      .quality-overflow-clipped {
        outline: 0.5pt solid rgb(180 120 0 / 36%);
        outline-offset: -0.5pt;
      }

      .quality-missing-translation,
      .quality-empty-translation {
        color: #555555;
      }

      .quality-overflow-clipped::after {
        content: "";
      }

      @media screen {
        body {
          padding: 18px;
        }

        .page {
          box-shadow: 0 2px 14px rgb(0 0 0 / 18%);
        }
      }

      @media print {
        body {
          background: #ffffff;
        }

        .page {
          margin: 0;
          box-shadow: none;
        }

        .page:last-child {
          page-break-after: auto;
          break-after: auto;
        }
      }
    </style>
  </head>
  <body>
    {% for page in document.pages %}
      <section
        class="page"
        data-page-id="{{ page.page_id }}"
        style="
          --page-width-pt: {{ page.size.width }}pt;
          --page-height-pt: {{ page.size.height }}pt;
          page: page-{{ page.page_id | css_class }};
        "
      >
        {% for asset in page.assets %}
          <figure
            class="asset asset-{{ asset.kind | css_class }}{% for flag in asset.quality_flags %} quality-{{ flag | css_class }}{% endfor %}"
            data-asset-id="{{ asset.asset_id }}"
            data-asset-kind="{{ asset.kind }}"
            style="
              --x-pt: {{ asset.bbox.x0 }}pt;
              --y-pt: {{ asset.bbox.y0 }}pt;
              --w-pt: {{ asset.bbox.x1 - asset.bbox.x0 }}pt;
              --h-pt: {{ asset.bbox.y1 - asset.bbox.y0 }}pt;
            "
          >
            {% if asset.path %}
              <img src="{{ asset.path }}" alt="{{ asset.alt_text or asset.asset_id }}" />
            {% else %}
              <div class="asset-placeholder">{{ asset.kind }}</div>
            {% endif %}
          </figure>
        {% endfor %}
        {% for block in page.blocks %}
          <div
            class="block role-{{ block.role | css_class }} intent-{{ block.render_intent | css_class }}{% for flag in block.quality_flags %} quality-{{ flag | css_class }}{% endfor %}"
            data-block-id="{{ block.block_id }}"
            data-render-intent="{{ block.render_intent }}"
            data-font-scale="{{ block.font_scale }}"
            data-bold="{{ block.style_seed.bold | lower }}"
            data-italic="{{ block.style_seed.italic | lower }}"
            style="
              --x-pt: {{ block.bbox.x0 }}pt;
              --y-pt: {{ block.bbox.y0 }}pt;
              --w-pt: {{ block.bbox.x1 - block.bbox.x0 }}pt;
              --h-pt: {{ block.bbox.y1 - block.bbox.y0 }}pt;
              --font-size-pt: {{ block.font_size_pt }}pt;
              --line-height: {{ block.line_height or document.line_height }};
              --text-align: {{ block.text_align or 'left' }};
              --font-weight: {{ block.font_weight or (700 if block.style_seed.bold else 400) }};
              --font-style: {{ block.font_style or ('italic' if block.style_seed.italic else 'normal') }};
              --first-line-indent-em: {{ block.first_line_indent_em }}em;
              color: {{ block.style_seed.color }};
            "
          >{% if block.html %}{{ block.html | safe }}{% else %}{{ block.text }}{% endif %}</div>
        {% endfor %}
        {% if page.footer_text %}
          <div class="page-footer">{{ page.footer_text }}</div>
        {% endif %}
      </section>
    {% endfor %}
  </body>
</html>
