{
  "$defs": {
    "InputKind": {
      "enum": [
        "text",
        "image",
        "pdf"
      ],
      "title": "InputKind",
      "type": "string"
    },
    "InputSourceRole": {
      "enum": [
        "content",
        "layout_reference"
      ],
      "title": "InputSourceRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "input_type": {
      "$ref": "#/$defs/InputKind"
    },
    "source_role": {
      "$ref": "#/$defs/InputSourceRole",
      "default": "content"
    },
    "filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "size_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Path"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "input_type"
  ],
  "title": "InputSource",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1"
}
