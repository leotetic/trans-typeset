{
  "$defs": {
    "FormulaSourceKind": {
      "enum": [
        "text_layer",
        "inline_text",
        "vector_candidate",
        "image_candidate",
        "mineru",
        "ocr",
        "mock",
        "unknown"
      ],
      "title": "FormulaSourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "latex": {
      "title": "Latex",
      "type": "string"
    },
    "display_mode": {
      "default": "display",
      "enum": [
        "inline",
        "display"
      ],
      "title": "Display Mode",
      "type": "string"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "accepted_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Provider"
    },
    "accepted_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Confidence"
    },
    "validator_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validator Status"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "source_kind": {
      "$ref": "#/$defs/FormulaSourceKind",
      "default": "unknown"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    }
  },
  "required": [
    "latex"
  ],
  "title": "FormulaRecognitionResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.2"
}
