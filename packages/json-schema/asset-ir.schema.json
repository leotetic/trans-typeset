{
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "kind": {
      "default": "unknown",
      "enum": [
        "image",
        "pdf_asset",
        "reference",
        "ocr_text",
        "unknown"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "ocr_text": {
      "default": "",
      "title": "Ocr Text",
      "type": "string"
    },
    "alt_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alt Text"
    },
    "source_block_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Block Ids",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "source_id"
  ],
  "title": "AssetIR",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1"
}
